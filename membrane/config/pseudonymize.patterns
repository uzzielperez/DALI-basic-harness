# Pseudonymization rules: <TOKEN_TYPE> <TAB> <regex>  (Python re syntax)
# First match wins per token type. Matched text -> <TYPE_n>, recorded in the
# local mapping table (never printed).
#
# Add your experiment's specific patterns ABOVE the generic ones.
# The rules below are HEP-flavoured examples - keep what applies, delete the
# rest, and add your own run periods / production labels / storage roots.

# --- run periods and data-taking years ---
DS	\b(Run(?:I{1,3}V?|II{0,3}b?|3|4)|Run\s?\d)\b
DS	\b20(1[1-8]|2[0-6])(?:[ab])?\b

# --- MC production / simulation campaign labels (edit for your campaign list) ---
DS	\bMC1[2-9][a-e]?\b
DS	\b(Sim\dw?[_-][A-Za-z0-9._-]+)\b

# --- physics / analysis and stream names (edit for your naming scheme) ---
DS	\b(B[sdub]?2[A-Za-z*]+(?:Gamma|GammaGamma|MuMu|EE)?)\b
DS	\b(DDQQ[DS]\|[^|\s]+)\b
DS	\b(?:BDT|CatBoost|XGBoost)?\s?[Ww][Pp][_-]?\w+\b

# --- experiment-specific dataset or campaign identifiers ---
DS	\b(LHCB[A-Z0-9._-]+)\b

# --- hostnames: batch, storage, and login nodes ---
HOST	\b[A-Za-z0-9.-]+\.(cern\.ch|fnal\.gov|in2p3\.fr|nikhef\.nl|ox\.ac\.uk|pic\.es)\b
HOST	\b[lx][a-z]+[0-9]+-[a-z0-9-]+\.cern\.ch\b

# --- filesystem paths: add your experiment's storage roots ---
PATH	(?:/home/|/eos/|/pnfs/|/cvmfs/|/data/|/scratch/|/mnt/|/work/|/user/)[^\s|,'"]+

# --- usernames: replace with your own account pattern(s) ---
USER	\b[a-z]{2,8}[0-9]{2,4}\b
