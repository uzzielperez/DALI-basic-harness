# Outbound secret filter - regex per line (Python re syntax), '#' starts a comment.
# Matches are replaced with [REDACTED] by membrane_filter.py.
-----BEGIN [A-Z ]*PRIVATE KEY-----
\bsk-[A-Za-z0-9_-]{10,}\b
\bxox[bpars]-[A-Za-z0-9-]{8,}\b
\bAKIA[0-9A-Z]{16}\b
\bghp_[A-Za-z0-9]{20,}\b
\bgho_[A-Za-z0-9]{20,}\b
\bgithub_pat_[A-Za-z0-9_]{20,}\b
\bglpat-[A-Za-z0-9_-]{20}\b
\bAIza[0-9A-Za-z_-]{35}\b
\beyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b
\b-----BEGIN CERTIFICATE-----
\b0x[0-9a-fA-F]{40,}\b
\b[a-f0-9]{40,}\b
\b[A-Za-z0-9+/]{60,}={0,2}\b
\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b
/CERN/[^/\s]+/
\bdcache:/+pnfs/[^/\s]+/
\broot://[A-Za-z0-9.-]+/
